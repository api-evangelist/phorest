{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phorest Third-Party Appointments Branches API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
